# Secrets for the Solana settler bot and bet-quote signer.
# Copy to an untracked .env.secrets and fill in. NEVER commit real keys.

# Base58-encoded private key for the settler bot (must be the program's oracle authority).
SETTLER_KEYPAIR=REPLACE_WITH_BASE58_SETTLER_PRIVATE_KEY

# Base58-encoded private key for the bet-quote signer (the program's quote_signer).
# Must NOT reuse SETTLER_KEYPAIR.
BET_QUOTE_SIGNER_KEYPAIR=REPLACE_WITH_BASE58_QUOTE_SIGNER_PRIVATE_KEY
