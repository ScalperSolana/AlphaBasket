# AlphaBasket secret template.
# Copy to an untracked .env.secrets and fill in. NEVER commit real keys.
#
# The backend processes currently load backend/.env. For internal testing,
# merge these variables with the public variables from .env.example into
# backend/.env, or inject both sets through the process/container environment.

# ──────────────────────────────────────────────────────────────
# AlphaBasket backend — hybrid internal testing
# ──────────────────────────────────────────────────────────────

# Authenticated RPC endpoints. Hybrid mode requires different Solana endpoints:
# devnet for accounting and mainnet-beta for funding, receipts and USDC splits.
ACCOUNTING_SOLANA_RPC_URL=REPLACE_WITH_AUTHENTICATED_SOLANA_DEVNET_RPC_URL
ACCOUNTING_SOLANA_WS_URL=REPLACE_WITH_AUTHENTICATED_SOLANA_DEVNET_WS_URL
CAPITAL_SOLANA_RPC_URL=REPLACE_WITH_AUTHENTICATED_SOLANA_MAINNET_RPC_URL
CAPITAL_SOLANA_WS_URL=REPLACE_WITH_AUTHENTICATED_SOLANA_MAINNET_WS_URL
POLYGON_RPC_URL=REPLACE_WITH_AUTHENTICATED_POLYGON_MAINNET_RPC_URL
ANCHOR_PROVIDER_URL=REPLACE_WITH_AUTHENTICATED_SOLANA_DEVNET_RPC_URL

# PostgreSQL credential. Local Temporal currently needs no credential; a hosted
# Temporal deployment must inject its provider-specific TLS/API credentials.
DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@127.0.0.1:5432/alphabasket

# API and internal service bearer tokens. Each value must be a distinct random
# secret of at least 32 characters.
COMPOSER_API_TOKEN=REPLACE_WITH_32_PLUS_CHARACTER_COMPOSER_API_TOKEN
OPERATIONS_API_TOKEN=REPLACE_WITH_32_PLUS_CHARACTER_OPERATIONS_API_TOKEN
EXECUTION_GATEWAY_TOKEN=REPLACE_WITH_32_PLUS_CHARACTER_GATEWAY_TOKEN
REMOTE_SIGNER_TOKEN=REPLACE_WITH_32_PLUS_CHARACTER_REMOTE_SIGNER_TOKEN

# Polymarket L2 CLOB credentials derived for POLYMARKET_EXECUTION_WALLET.
# These remain inside the execution gateway.
POLYMARKET_CLOB_API_KEY=REPLACE_WITH_POLYMARKET_CLOB_API_KEY
POLYMARKET_CLOB_API_SECRET=REPLACE_WITH_POLYMARKET_CLOB_API_SECRET
POLYMARKET_CLOB_API_PASSPHRASE=REPLACE_WITH_POLYMARKET_CLOB_API_PASSPHRASE

# Server-side key from the Jupiter Developer Platform. Required only when
# JUPITER_SPOT_ENABLED=true; never expose it to the browser bundle.
JUPITER_API_KEY=REPLACE_WITH_JUPITER_DEVELOPER_API_KEY

# Optional alert authentication. Set only when both alert URLs are enabled in
# .env.example.
# ALERT_WEBHOOK_HMAC_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_ALERT_HMAC_SECRET

# No raw Composer, backend-completion, Polygon-execution or Solana-settlement
# private key belongs in an environment file. Internal testing stores them only
# in the ignored mode-0600 development keyring. Production stores them in KMS/HSM.
