NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
API_SHUTDOWN_GRACE_MS=10000
# Exact browser origins allowed to call /v1/*, comma separated.
API_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_MAXIMUM_BODY_BYTES=65536
API_MAXIMUM_NAV_AGE_MS=30000
# Required to enable authenticated POST /v1/baskets.
# COMPOSER_API_TOKEN=replace-with-at-least-32-random-characters
# Required to expose authenticated /ops/* endpoints. Use a random 32+ character secret.
# OPERATIONS_API_TOKEN=
RECONCILIATION_SCOPE=global

# Environment safety boundary. Hybrid testing uses a devnet accounting program
# while real USDC moves on Solana mainnet and Polymarket/Polygon mainnet.
DEPLOYMENT_MODE=local
ACCOUNTING_SOLANA_CLUSTER=localnet
CAPITAL_SOLANA_CLUSTER=localnet
CAPITAL_MODE=mock
MANAGEMENT_FEE_KEEPER_INTERVAL_MS=3600000
RECONCILIATION_INTERVAL_MS=60000
OUTBOX_INTERVAL_MS=5000
MANAGEMENT_FEE_MINIMUM_ACCRUAL_SECONDS=3600
LIFECYCLE_SCAN_LIMIT=1000
RECONCILIATION_ASSET_TOLERANCE_UNITS=1
RECONCILIATION_MAX_NAV_AGE_MS=120000
RECONCILIATION_MAX_PENDING_AGE_MS=900000
CANARY_MAX_OPERATION_UNITS=10000000
CANARY_MAX_DAILY_UNITS=50000000
CANARY_ALLOWED_BASKETS=
CANARY_ALLOWED_WALLETS=
DATABASE_URL=postgresql://alphabasket:alphabasket@127.0.0.1:5432/alphabasket
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=alphabasket
EXECUTION_DISPATCH_INTERVAL_MS=2000
EXECUTION_DISPATCH_BATCH_SIZE=50
EXECUTION_DISPATCH_CLAIM_MS=30000
EXECUTION_DISPATCH_RETRY_MS=5000
EXECUTION_WALLET_LEASE_MS=120000
# Authenticated internal gateway that signs Polymarket FAK orders, submits
# Polygon pUSD transfers, and performs the atomic Solana fee split.
# EXECUTION_GATEWAY_URL=https://execution.internal.example
# EXECUTION_GATEWAY_TOKEN=replace-with-at-least-32-random-characters
EXECUTION_GATEWAY_HOST=127.0.0.1
EXECUTION_GATEWAY_PORT=3002
EXECUTION_GATEWAY_MAXIMUM_BODY_BYTES=65536
# Hard capital limits enforced again inside the key boundary.
EXECUTION_GATEWAY_MAXIMUM_MAKER_UNITS=10000000
EXECUTION_GATEWAY_MAXIMUM_TAKER_UNITS=1000000000
EXECUTION_GATEWAY_MAXIMUM_TRANSFER_UNITS=10000000
EXECUTION_GATEWAY_MAXIMUM_SPLIT_UNITS=10000000
EXECUTION_GATEWAY_MAXIMUM_JUPITER_SWAP_UNITS=10000000
EXECUTION_GATEWAY_MAXIMUM_POLYGON_FEE_WEI=100000000000000000
EXECUTION_GATEWAY_MAXIMUM_SOLANA_FEE_LAMPORTS=10000000

INDEXER_ACCOUNT_INTERVAL_MS=5000
INDEXER_EVENT_INTERVAL_MS=2000
INDEXER_EVENT_PAGE_SIZE=100
INDEXER_EVENT_MAX_PAGES=100
INDEXER_BOOTSTRAP_POLICY=backfill
NAV_SNAPSHOT_INTERVAL_MS=10000
NAV_MAX_MARK_AGE_MS=60000
NAV_SCAN_LIMIT=1000

# AlphaBasket program, indexer, lifecycle and complete_* transactions.
ACCOUNTING_SOLANA_RPC_URL=http://127.0.0.1:8899
ACCOUNTING_SOLANA_WS_URL=ws://127.0.0.1:8900
ALPHABASKET_PROGRAM_ID=5mzLoAijdzAQV5D7QXe6TTGZ9TkWQanygfnb5VPPxFSm

# User funding, Polymarket withdrawal receipts and fee distributions. For
# hybrid_devnet these MUST point to Solana mainnet-beta, not devnet; every
# worker verifies the RPC's genesis hash at startup and refuses to run if the
# cluster does not match this label.
#
# A keyed provider belongs here rather than in the frontend: this file is
# server-side and gitignored. The endpoint must serve getTransaction with
# jsonParsed encoding and pre/postTokenBalances, because the funding verifier
# and the Predict gateway check cash movement against finalized token deltas.
CAPITAL_SOLANA_RPC_URL=http://127.0.0.1:8899
# CAPITAL_SOLANA_WS_URL=wss://your-provider.example/?api_key=REPLACE_ME
CAPITAL_SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Which venue executes prediction-market composition items.
#   jupiter_predict  Solana-native: Polymarket markets served through Jupiter's
#                    Prediction API, USDC in and out of SOLANA_SETTLEMENT_RECEIVER,
#                    no Polygon leg at all. Requires JUPITER_API_KEY on the
#                    execution worker, gateway and NAV worker, and
#                    JUPITER_PREDICT_PROGRAM_IDS on the gateway.
#   polymarket       The original Polygon path (CLOB, bridge, pUSD). Needs every
#                    POLYMARKET_*/POLYGON_* value below.
#   disabled         Prediction baskets are refused at the quote layer.
PREDICTION_VENUE=jupiter_predict
JUPITER_PREDICT_URL=https://api.jup.ag/prediction/v1
# Top-level programs the settlement key may sign in Predict-built transactions.
# The Prediction API is in beta without a published program id, so this is
# deliberately explicit; read it off a transaction built by the API.
# JUPITER_PREDICT_PROGRAM_IDS=
# The API rejects orders below $5 (six-decimal units).
JUPITER_PREDICT_MINIMUM_ORDER_UNITS=5000000
EXECUTION_GATEWAY_MAXIMUM_PREDICT_ORDER_UNITS=10000000

# Polygon-venue endpoints; unused when PREDICTION_VENUE=jupiter_predict.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
POLYMARKET_BRIDGE_URL=https://bridge.polymarket.com
# POLYMARKET_BUILDER_CODE=0x...
# Required for live Polygon verification/resolution execution.
# POLYGON_RPC_URL=https://polygon-mainnet.example
POLYGON_CHAIN_ID=137
# Polygon pUSD contract used for independent credit/balance verification.
# POLYMARKET_PUSD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# Explicit chain identifier expected by the Polymarket withdrawal API.
# POLYMARKET_SOLANA_CHAIN_ID=
# Shared Polygon execution wallet. Wallet sharding is configured in PostgreSQL.
# POLYMARKET_EXECUTION_WALLET=0x0000000000000000000000000000000000000000
# L2 credentials stay inside the execution gateway and are never exposed to
# the API server or Temporal execution worker.
# POLYMARKET_CLOB_API_KEY=
# POLYMARKET_CLOB_API_SECRET=
# POLYMARKET_CLOB_API_PASSPHRASE=
# Required only for local/mock or explicitly staged testing. Hybrid live-bridge
# deposits receive a fresh Solana mainnet address from the Bridge API.
# STAGING_SOLANA_FUNDING_DESTINATION=11111111111111111111111111111111
# Solana mainnet owner receiving live bridge withdrawals. The execution gateway
# atomically splits mainnet USDC from this owner.
# SOLANA_SETTLEMENT_RECEIVER=11111111111111111111111111111111

# Jupiter spot admission, execution and pricing. In hybrid_devnet, Jupiter swaps
# execute from SOLANA_SETTLEMENT_RECEIVER on Solana mainnet-beta and finalized
# share accounting is recorded by the AlphaBasket program on devnet.
JUPITER_SPOT_ENABLED=false
JUPITER_TOKENS_URL=https://api.jup.ag/tokens/v2
JUPITER_SWAP_URL=https://api.jup.ag/swap/v2
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
JUPITER_AGGREGATOR_PROGRAM_ID=JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4
# Reasonable-size USDC route probe in six-decimal units.
JUPITER_ROUTE_PROBE_UNITS=1000000
# Explicit admin-vetted xStocks mints, comma separated. Never populate this
# automatically from the broad Jupiter "stocks" tag.
JUPITER_XSTOCK_MINTS=
# JUPITER_API_KEY=replace-with-jupiter-developer-api-key

# Backend processes receive opaque remote signer identifiers, never raw keys.
COMPOSER_SIGNER_KEY_ID=alphabasket-composer-dev
BACKEND_SIGNER_KEY_ID=alphabasket-settlement-dev
POLYMARKET_SIGNER_KEY_ID=alphabasket-polymarket-dev
SOLANA_SETTLEMENT_SIGNER_KEY_ID=alphabasket-usdc-dev

# Internal testing: run the loopback-only development signer in this repository.
# Its keyring path must be absolute and the file must have mode 0600.
REMOTE_SIGNER_HOST=127.0.0.1
REMOTE_SIGNER_PORT=3003
REMOTE_SIGNER_PROVIDER=development_file
# REMOTE_SIGNER_KEYRING_FILE=/absolute/path/to/AlphaBasket/backend/.remote-signer/keyring.json
REMOTE_SIGNER_MAXIMUM_BODY_BYTES=16384
REMOTE_SIGNER_MAXIMUM_CONCURRENT_SIGNATURES=16
REMOTE_SIGNER_URL=http://127.0.0.1:3003
# REMOTE_SIGNER_TOKEN=replace-with-at-least-32-random-characters
# BACKEND_SIGNER_PUBLIC_KEY=11111111111111111111111111111111
# COMPOSER_SIGNER_PUBLIC_KEY=11111111111111111111111111111111

# Optional alert delivery. Configure all three or none. Critical findings go
# to the paging webhook and warnings go to the ticket webhook.
# ALERT_PAGING_WEBHOOK_URL=https://alerts.example/v1/page
# ALERT_TICKET_WEBHOOK_URL=https://alerts.example/v1/ticket
# ALERT_WEBHOOK_HMAC_SECRET=replace-with-at-least-32-random-characters
