{
  "name": "@alphabasket/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/apps/server.ts",
    "dev:lifecycle": "node --env-file-if-exists=.env --watch --import tsx src/apps/lifecycle-worker.ts",
    "dev:indexer": "node --env-file-if-exists=.env --watch --import tsx src/apps/indexer-worker.ts",
    "dev:nav": "node --env-file-if-exists=.env --watch --import tsx src/apps/nav-worker.ts",
    "dev:execution": "node --env-file-if-exists=.env --watch --import tsx src/apps/execution-worker.ts",
    "dev:execution-gateway": "node --env-file-if-exists=.env --watch --import tsx src/apps/execution-gateway.ts",
    "dev:remote-signer": "node --env-file-if-exists=.env --watch --import tsx src/apps/remote-signer.ts",
    "dev:execution-dispatcher": "node --env-file-if-exists=.env --watch --import tsx src/apps/execution-dispatcher-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/apps/server.js",
    "start:lifecycle": "node --env-file-if-exists=.env dist/src/apps/lifecycle-worker.js",
    "start:indexer": "node --env-file-if-exists=.env dist/src/apps/indexer-worker.js",
    "start:nav": "node --env-file-if-exists=.env dist/src/apps/nav-worker.js",
    "start:execution": "node --env-file-if-exists=.env dist/src/apps/execution-worker.js",
    "start:execution-gateway": "node --env-file-if-exists=.env dist/src/apps/execution-gateway.js",
    "start:remote-signer": "node --env-file-if-exists=.env dist/src/apps/remote-signer.js",
    "start:execution-dispatcher": "node --env-file-if-exists=.env dist/src/apps/execution-dispatcher-worker.js",
    "start:lifecycle:build": "npm run build && npm run start:lifecycle",
    "start:indexer:build": "npm run build && npm run start:indexer",
    "start:nav:build": "npm run build && npm run start:nav",
    "start:execution:build": "npm run build && npm run start:execution",
    "start:execution-gateway:build": "npm run build && npm run start:execution-gateway",
    "start:remote-signer:build": "npm run build && npm run start:remote-signer",
    "start:execution-dispatcher:build": "npm run build && npm run start:execution-dispatcher",
    "start:build": "npm run build && npm start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js",
    "check": "npm run typecheck && npm test",
    "migrate": "npm run build && node dist/src/apps/migrate.js",
    "signer:keyring:generate": "node --env-file-if-exists=.env --import tsx src/apps/generate-remote-signer-keyring.ts",
    "idl:check": "node scripts/check-idl.mjs",
    "idl:sync": "node scripts/sync-idl.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/hashes": "^1.8.0",
    "@solana/web3.js": "^1.95.4",
    "@temporalio/client": "^1.11.8",
    "@temporalio/worker": "^1.11.8",
    "bs58": "^6.0.0",
    "pg": "^8.16.3",
    "viem": "^2.55.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "jayson": {
      "uuid": "11.1.1"
    }
  }
}
