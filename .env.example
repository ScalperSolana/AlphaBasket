# ──────────────────────────────────────────────────────────────
# AlphaBasket backend — hybrid internal testing
# ──────────────────────────────────────────────────────────────
# This file contains public/non-secret configuration. The credentials and
# authenticated RPC URLs are listed separately in .env.secrets.example.
#
# The backend processes load backend/.env. For internal testing, copy the
# variables from this file and .env.secrets.example into backend/.env, replacing
# every REPLACE_WITH_* value. Do not commit backend/.env.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
API_SHUTDOWN_GRACE_MS=10000
API_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_MAXIMUM_BODY_BYTES=65536
API_MAXIMUM_NAV_AGE_MS=30000
RECONCILIATION_SCOPE=global

# Hybrid boundary: accounting is on Solana devnet; real capital moves through
# Solana mainnet-beta and Polymarket on Polygon mainnet.
DEPLOYMENT_MODE=hybrid_devnet
ACCOUNTING_SOLANA_CLUSTER=devnet
CAPITAL_SOLANA_CLUSTER=mainnet-beta
CAPITAL_MODE=live_bridge
ALPHABASKET_PROGRAM_ID=5mzLoAijdzAQV5D7QXe6TTGZ9TkWQanygfnb5VPPxFSm
CAPITAL_SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
POLYGON_CHAIN_ID=137

# Public Polymarket endpoints and network identifiers.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
POLYMARKET_BRIDGE_URL=https://bridge.polymarket.com
POLYMARKET_PUSD_TOKEN_ADDRESS=REPLACE_WITH_POLYMARKET_PUSD_TOKEN_ADDRESS
POLYMARKET_SOLANA_CHAIN_ID=REPLACE_WITH_POLYMARKET_SOLANA_CHAIN_ID
# Optional public attribution identifier supplied by Polymarket.
# POLYMARKET_BUILDER_CODE=0xREPLACE_WITH_64_HEX_CHARACTERS
# Only used by mock/prefunded staging; hybrid live-bridge testing does not use it.
# STAGING_SOLANA_FUNDING_DESTINATION=REPLACE_WITH_STAGING_SOLANA_DESTINATION

# Public operational wallet addresses. Their private keys remain in the remote
# signer (the ignored development keyring or production KMS/HSM) and are
# referenced only through the key IDs below.
POLYMARKET_EXECUTION_WALLET=REPLACE_WITH_POLYGON_0X_EXECUTION_WALLET
SOLANA_SETTLEMENT_RECEIVER=REPLACE_WITH_SOLANA_MAINNET_SETTLEMENT_OWNER
COMPOSER_SIGNER_PUBLIC_KEY=REPLACE_WITH_SOLANA_COMPOSER_PUBLIC_KEY
BACKEND_SIGNER_PUBLIC_KEY=REPLACE_WITH_SOLANA_BACKEND_PUBLIC_KEY

# Opaque remote-signer identifiers; these are not private keys.
COMPOSER_SIGNER_KEY_ID=alphabasket-composer-internal
BACKEND_SIGNER_KEY_ID=alphabasket-settlement-internal
POLYMARKET_SIGNER_KEY_ID=alphabasket-polymarket-internal
SOLANA_SETTLEMENT_SIGNER_KEY_ID=alphabasket-usdc-internal

# Internal services.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=alphabasket
EXECUTION_GATEWAY_URL=http://127.0.0.1:3002
EXECUTION_GATEWAY_HOST=127.0.0.1
EXECUTION_GATEWAY_PORT=3002
REMOTE_SIGNER_URL=http://127.0.0.1:3003
REMOTE_SIGNER_HOST=127.0.0.1
REMOTE_SIGNER_PORT=3003
REMOTE_SIGNER_PROVIDER=development_file
REMOTE_SIGNER_KEYRING_FILE=REPLACE_WITH_ABSOLUTE_PATH_TO_BACKEND_KEYRING
REMOTE_SIGNER_MAXIMUM_BODY_BYTES=16384
REMOTE_SIGNER_MAXIMUM_CONCURRENT_SIGNATURES=16

# Canary safety limits use six-decimal USDC base units.
CANARY_MAX_OPERATION_UNITS=10000000
CANARY_MAX_DAILY_UNITS=50000000
CANARY_ALLOWED_BASKETS=REPLACE_WITH_ALLOWLISTED_BASKET_ID
CANARY_ALLOWED_WALLETS=REPLACE_WITH_ALLOWLISTED_EXECUTION_WALLET_ID

# Lifecycle, reconciliation, dispatch and wallet leasing.
MANAGEMENT_FEE_KEEPER_INTERVAL_MS=3600000
RECONCILIATION_INTERVAL_MS=60000
OUTBOX_INTERVAL_MS=5000
MANAGEMENT_FEE_MINIMUM_ACCRUAL_SECONDS=3600
LIFECYCLE_SCAN_LIMIT=1000
RECONCILIATION_ASSET_TOLERANCE_UNITS=1
RECONCILIATION_MAX_NAV_AGE_MS=120000
RECONCILIATION_MAX_PENDING_AGE_MS=900000
EXECUTION_DISPATCH_INTERVAL_MS=2000
EXECUTION_DISPATCH_BATCH_SIZE=50
EXECUTION_DISPATCH_CLAIM_MS=30000
EXECUTION_DISPATCH_RETRY_MS=5000
EXECUTION_WALLET_LEASE_MS=120000

# Execution-gateway hard limits.
EXECUTION_GATEWAY_MAXIMUM_BODY_BYTES=65536
EXECUTION_GATEWAY_MAXIMUM_MAKER_UNITS=10000000
EXECUTION_GATEWAY_MAXIMUM_TAKER_UNITS=1000000000
EXECUTION_GATEWAY_MAXIMUM_TRANSFER_UNITS=10000000
EXECUTION_GATEWAY_MAXIMUM_SPLIT_UNITS=10000000
EXECUTION_GATEWAY_MAXIMUM_POLYGON_FEE_WEI=100000000000000000
EXECUTION_GATEWAY_MAXIMUM_SOLANA_FEE_LAMPORTS=10000000

# Indexer and NAV workers.
INDEXER_ACCOUNT_INTERVAL_MS=5000
INDEXER_EVENT_INTERVAL_MS=2000
INDEXER_EVENT_PAGE_SIZE=100
INDEXER_EVENT_MAX_PAGES=100
INDEXER_BOOTSTRAP_POLICY=backfill
NAV_SNAPSHOT_INTERVAL_MS=10000
NAV_MAX_MARK_AGE_MS=60000
NAV_SCAN_LIMIT=1000

# One-time devnet program initialization. ANCHOR_PROVIDER_URL belongs in
# .env.secrets.example because hosted RPC URLs commonly contain credentials.
ANCHOR_WALLET=REPLACE_WITH_DEVNET_UPGRADE_AUTHORITY_KEYPAIR_PATH
COMPOSER_SIGNER=REPLACE_WITH_SOLANA_COMPOSER_PUBLIC_KEY
BACKEND_SIGNER=REPLACE_WITH_SOLANA_BACKEND_PUBLIC_KEY
PROTOCOL_TREASURY=REPLACE_WITH_SOLANA_MAINNET_PROTOCOL_TREASURY_OWNER
SETTLEMENT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MAX_SLIPPAGE_BPS=1000

# Optional alert routing. If enabled, configure both URLs here and the HMAC
# secret in .env.secrets.example; otherwise leave all three unset.
# ALERT_PAGING_WEBHOOK_URL=https://alerts.internal.example/v1/page
# ALERT_TICKET_WEBHOOK_URL=https://alerts.internal.example/v1/ticket

# ──────────────────────────────────────────────────────────────
# Legacy frontend and services
# ──────────────────────────────────────────────────────────────
# The variables below belong to the pre-V2 frontend, settler and AI services.

# ──────────────────────────────────────────────────────────────
# Frontend (Vite) — Solana
# ──────────────────────────────────────────────────────────────
# Solana RPC endpoint. Use a Helius/QuickNode URL in production for reliability.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Cluster: devnet | testnet | mainnet-beta
VITE_SOLANA_CLUSTER=devnet
# Deployed Anchor program ID (devnet first).
VITE_PROGRAM_ID=5mzLoAijdzAQV5D7QXe6TTGZ9TkWQanygfnb5VPPxFSm
# USDC SPL mint used for stakes (devnet USDC).
VITE_USDC_MINT=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr
# Legacy UI metadata for the config-admin/treasury wallet (base58). The program
# does not trust this value: fees go to Config.treasury_usdc, a token-account PDA.
VITE_TREASURY_ADDRESS=REPLACE_WITH_TREASURY_WALLET_PUBKEY
# Entry-index quote signer service URL (signs the Ed25519 quotes the escrow verifies).
VITE_QUOTE_API_URL=
# DEV ONLY: JSON array of 64 ints (a keypair secret) to sign quotes client-side.
# Insecure — never set in production; use VITE_QUOTE_API_URL instead.
VITE_DEV_QUOTE_SIGNER_SECRET=
VITE_ENABLE_MANUAL_BETTING=true

# Explorer hold (maintenance) screen
VITE_EXPLORER_HOLD_ENABLED=false
VITE_EXPLORER_HOLD_BADGE=Temporary pause
VITE_EXPLORER_HOLD_TITLE=PolyBaskets is taking a short pause
VITE_EXPLORER_HOLD_MESSAGE=We are polishing the next launch experience. Stay close, the app will reopen soon and we would love to have you there on day one.
VITE_EXPLORER_HOLD_PRIMARY_CTA_LABEL=Get launch updates
VITE_EXPLORER_HOLD_PRIMARY_CTA_URL=https://t.me/polybaskets

# ──────────────────────────────────────────────────────────────
# Settler bot (Solana) — polls Polymarket, posts settlement on-chain
# ──────────────────────────────────────────────────────────────
# Solana RPC for the bot (can differ from the frontend RPC).
SETTLER_RPC_URL=https://api.devnet.solana.com
SETTLER_BOT_POLL_INTERVAL_MS=30000
SETTLER_BOT_PROPOSE_ENABLED=true
SETTLER_BOT_FINALIZE_ENABLED=true
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
# Secret (SETTLER_KEYPAIR) lives in .env.secrets — see .env.secrets.example.

# ──────────────────────────────────────────────────────────────
# Bet quote signer service (Solana Ed25519 signer)
# ──────────────────────────────────────────────────────────────
BET_QUOTE_SERVICE_PORT=4360
# Quote lifetime in ms; the escrow rejects quotes past expiry.
BET_QUOTE_TTL_MS=120000
# Solana RPC the quote service uses to read basket composition on-chain.
QUOTE_RPC_URL=https://api.devnet.solana.com
# Secret (BET_QUOTE_SIGNER_KEYPAIR) lives in .env.secrets — see .env.secrets.example.
FRONTEND_URLS=http://localhost:8080,http://127.0.0.1:8080
