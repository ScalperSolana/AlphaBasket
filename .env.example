# Local Postgres / GraphQL exposure
DB_NAME=polybaskets_indexer
DB_USER=postgres
DB_PASS=REPLACE_WITH_LOCAL_DB_PASSWORD
POSTGRES_PORT=5432
INDEXER_GQL_PORT=4350
BET_QUOTE_SERVICE_PORT=4360
INDEXER_GRAPHIQL_ENABLED=true
FRONTEND_URLS=http://localhost:8080,http://127.0.0.1:8080

# Shared chain/indexer source configuration
VARA_ARCHIVE_URL=REPLACE_WITH_ARCHIVE_URL
SQD_API_KEY=REPLACE_WITH_SQD_API_KEY
VARA_RPC_URL=REPLACE_WITH_RPC_URL
VARA_RPC_RATE_LIMIT=20
VARA_FROM_BLOCK=REPLACE_WITH_DEPLOY_BLOCK

# Program ids
BASKET_MARKET_PROGRAM_ID=REPLACE_WITH_BASKET_MARKET_PROGRAM_ID
BET_LANE_PROGRAM_ID=REPLACE_WITH_BET_LANE_PROGRAM_ID
BET_TOKEN_PROGRAM_ID=REPLACE_WITH_BET_TOKEN_PROGRAM_ID
DAILY_CONTEST_PROGRAM_ID=REPLACE_WITH_DAILY_CONTEST_PROGRAM_ID

# Daily contest read side / settlement
CONTEST_GRACE_PERIOD_MS=1800000
CONTEST_BOT_POLL_INTERVAL_MS=30000
AGENT_PUBLIC_ID_SALT=polybaskets-agent-public-id-v1

# Basket settlement bot
SETTLER_BOT_POLL_INTERVAL_MS=30000
SETTLER_BOT_FINALIZE_ENABLED=true
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
BET_QUOTE_TTL_MS=30000
BET_QUOTE_BINDING_PREFIX=BetLaneQuoteV1
VARA_RECONNECT_ATTEMPTS=5
VARA_RECONNECT_DELAY_MS=1000
VARA_RECONNECT_MAX_DELAY_MS=10000

# Frontend endpoints (Solana)
# Cluster: devnet | testnet | mainnet-beta
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC=https://api.devnet.solana.com
# SPL mint used for stakes. Default is Circle USDC on devnet.
VITE_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# House funder wallet (base58). Tops up basket vaults to cover net winnings.
VITE_TREASURY_ADDRESS=REPLACE_WITH_TREASURY_WALLET_PUBKEY
# Entry-index quote signer service (Solana equivalent of the Vara bet-quote-service).
VITE_QUOTE_API_URL=
# DEV ONLY: JSON array of 64 ints (a keypair secret) to sign quotes client-side.
# Insecure — never set in production; use VITE_QUOTE_API_URL instead.
VITE_DEV_QUOTE_SIGNER_SECRET=
VITE_ENABLE_MANUAL_BETTING=true
VITE_INDEXER_GRAPHQL_ENDPOINT=http://localhost:4350/graphql
VITE_CONTEST_DAY_BOUNDARY_OFFSET_MS=43200000
VITE_EXPLORER_HOLD_ENABLED=false
VITE_EXPLORER_HOLD_BADGE=Temporary pause
VITE_EXPLORER_HOLD_TITLE=PolyBaskets is taking a short pause
VITE_EXPLORER_HOLD_MESSAGE=We are polishing the next launch experience. Stay close, the app will reopen soon and we would love to have you there on day one.
VITE_EXPLORER_HOLD_PRIMARY_CTA_LABEL=Get launch updates
VITE_EXPLORER_HOLD_PRIMARY_CTA_URL=https://t.me/polybaskets

# Shared bot secret lives outside this template.
# Use .env.secrets and set exactly one of:
#   SETTLER_SEED=
#   SETTLER_SEED_FILE=

# Dedicated bet quote signer secret also lives outside this template.
# Use .env.secrets and set exactly one of:
#   BET_QUOTE_SIGNER_SEED=
#   BET_QUOTE_SIGNER_SEED_FILE=
