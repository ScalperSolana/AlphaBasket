type BasketMarketInit = struct {
  admin_role: actor_id,
  settler_role: actor_id,
  liveness_ms: u64,
  quote_signer: actor_id,
  bet_cutoff_ms: u64,
};

type SignedVaraBetQuote = struct {
  payload: VaraBetQuotePayload,
  signature: vec u8,
};

type VaraBetQuotePayload = struct {
  target_program_id: actor_id,
  user: actor_id,
  basket_id: u64,
  amount: u128,
  quoted_index_bps: u16,
  earliest_end_timestamp: u64,
  deadline_ms: u64,
  nonce: u128,
};

type BasketItem = struct {
  poly_market_id: str,
  poly_slug: str,
  weight_bps: u16,
  selected_outcome: Outcome,
  end_timestamp: u64,
};

type Outcome = enum {
  YES,
  NO,
};

type BasketAssetKind = enum {
  Vara,
  Bet,
};

type AgentInfo = struct {
  address: actor_id,
  name: str,
  registered_at: u64,
  name_updated_at: u64,
};

type Basket = struct {
  id: u64,
  creator: actor_id,
  name: str,
  description: str,
  items: vec BasketItem,
  created_at: u64,
  status: BasketStatus,
  asset_kind: BasketAssetKind,
};

type BasketStatus = enum {
  Active,
  SettlementPending,
  Settled,
};

type Position = struct {
  basket_id: u64,
  user: actor_id,
  shares: u128,
  claimed: bool,
  index_at_creation_bps: u16,
};

type Settlement = struct {
  basket_id: u64,
  proposer: actor_id,
  item_resolutions: vec ItemResolution,
  payout_per_share: u128,
  payload: str,
  proposed_at: u64,
  challenge_deadline: u64,
  finalized_at: opt u64,
  status: SettlementStatus,
};

type ItemResolution = struct {
  item_index: u8,
  resolved: Outcome,
  poly_slug: str,
  poly_condition_id: opt str,
  poly_price_yes: u16,
  poly_price_no: u16,
};

type SettlementStatus = enum {
  Proposed,
  Finalized,
};

type BasketMarketConfig = struct {
  admin_role: actor_id,
  settler_role: actor_id,
  liveness_ms: u64,
  vara_enabled: bool,
  min_items_per_basket: u32,
  quote_signer: actor_id,
  bet_cutoff_ms: u64,
};

type BasketMarketError = enum {
  Unauthorized,
  Paused,
  MigrationRequiresPause,
  MigrationBatchTooLarge,
  BasketNotFound,
  BasketNotActive,
  BasketAssetMismatch,
  NoItems,
  NotEnoughItems,
  InvalidWeights,
  DuplicateBasketItem,
  TooManyItems,
  NameTooLong,
  DescriptionTooLong,
  MarketIdTooLong,
  SlugTooLong,
  PayloadTooLong,
  VaraDisabled,
  SettlementAlreadyExists,
  SettlementNotFound,
  SettlementNotProposed,
  SettlementNotFinalized,
  ChallengeDeadlineNotPassed,
  InvalidIndexAtCreation,
  QuoteSignerNotConfigured,
  QuoteTargetMismatch,
  QuoteUserMismatch,
  QuoteBasketMismatch,
  QuoteAmountMismatch,
  QuoteExpired,
  QuoteNonceAlreadyUsed,
  InvalidQuoteSignature,
  InvalidQuoteSigner,
  QuoteVerificationFailed,
  BetCutoffReached,
  QuoteExpiryMismatch,
  InvalidBetAmount,
  InvalidFreebetAmount,
  InvalidResolutionCount,
  DuplicateResolutionIndex,
  ResolutionIndexOutOfBounds,
  ResolutionSlugMismatch,
  InvalidResolution,
  AlreadyClaimed,
  NothingToClaim,
  TransferFailed,
  FreebetLedgerNotConfigured,
  FreebetLedgerReturnFailed,
  MathOverflow,
  EventEmitFailed,
  InvalidConfig,
  AgentNameTooShort,
  AgentNameTooLong,
  AgentNameInvalid,
  AgentNameTaken,
  AgentRenameCooldown,
};

type MigrationEntityKind = enum {
  Baskets,
  Settlements,
  Positions,
  Agents,
};

constructor {
  New : (init: BasketMarketInit);
};

service BasketMarket {
  AdminWithdrawVara : (to: actor_id, amount: u128) -> u128;
  BetOnBasket : (basket_id: u64, signed_quote: SignedVaraBetQuote) -> u128;
  BetOnBasketFromFreebetLedger : (user: actor_id, basket_id: u64, signed_quote: SignedVaraBetQuote) -> u128;
  Claim : (basket_id: u64) -> u128;
  CreateBasket : (name: str, description: str, items: vec BasketItem, asset_kind: BasketAssetKind) -> u64;
  FinalizeSettlement : (basket_id: u64) -> null;
  ImportAgents : (agents: vec AgentInfo) -> u32;
  ImportBaskets : (baskets: vec Basket) -> u32;
  ImportPositions : (positions: vec Position) -> u32;
  ImportSettlements : (settlements: vec Settlement) -> u32;
  Pause : () -> null;
  ProposeSettlement : (basket_id: u64, item_resolutions: vec ItemResolution, payload: str) -> null;
  /// Register an agent with a display name, or rename if already registered.
  /// Input is normalized to lowercase. Names must be 3-20 chars, alphanumeric
  /// and hyphens only, no leading/trailing hyphens. Rename has a 7-day cooldown.
  RegisterAgent : (name: str) -> null;
  Resume : () -> null;
  SetConfig : (config: BasketMarketConfig) -> null;
  SetFreebetLedger : (ledger_id: actor_id) -> null;
  SetVaraEnabled : (enabled: bool) -> null;
  query GetAgent : (address: actor_id) -> opt AgentInfo;
  query GetAgentCount : () -> u64;
  query GetAllAgents : () -> vec AgentInfo;
  query GetBasket : (basket_id: u64) -> result (Basket, BasketMarketError);
  query GetBasketCount : () -> u64;
  query GetConfig : () -> BasketMarketConfig;
  query GetFreebetLedger : () -> actor_id;
  query GetFreebetPositions : (user: actor_id) -> vec Position;
  query GetPositions : (user: actor_id) -> vec Position;
  query GetSettlement : (basket_id: u64) -> result (Settlement, BasketMarketError);
  query IsPaused : () -> bool;
  query IsVaraEnabled : () -> bool;

  events {
    BasketCreated: struct {
      basket_id: u64,
      creator: actor_id,
      asset_kind: BasketAssetKind,
    };
    VaraBetPlaced: struct {
      basket_id: u64,
      user: actor_id,
      amount: u128,
      user_total: u128,
      index_at_creation_bps: u16,
      quote_nonce: u128,
    };
    FreebetBetPlaced: struct {
      basket_id: u64,
      user: actor_id,
      amount: u128,
      user_total: u128,
      index_at_creation_bps: u16,
      quote_nonce: u128,
    };
    SettlementProposed: struct {
      basket_id: u64,
      asset_kind: BasketAssetKind,
      proposer: actor_id,
      payout_per_share: u128,
      challenge_deadline: u64,
    };
    SettlementFinalized: struct {
      basket_id: u64,
      asset_kind: BasketAssetKind,
      finalized_at: u64,
      payout_per_share: u128,
    };
    Claimed: struct {
      basket_id: u64,
      user: actor_id,
      amount: u128,
    };
    AdminVaraWithdrawn: struct {
      to: actor_id,
      amount: u128,
    };
    AgentRegistered: struct {
      agent: actor_id,
      name: str,
    };
    AgentRenamed: struct {
      agent: actor_id,
      old_name: str,
      new_name: str,
    };
    VaraSupportUpdated: struct {
      enabled: bool
    };
    ConfigUpdated: struct {
      config: BasketMarketConfig
    };
    Paused;
    Resumed;
    MigrationBatchImported: struct {
      entity: MigrationEntityKind,
      count: u32,
    };
  }
};

